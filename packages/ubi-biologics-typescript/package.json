{
  "name": "ubi-biologics-typescript",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "Typed scientific workflow client for Ubi Biologics",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/schema.d.ts dist/schema.d.ts",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "@types/node": "22.18.6"
  },
  "author": "UniBio Intelligence",
  "keywords": [
    "biologics",
    "scientific-workflows",
    "ubi-biologics-toolkit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/unibio-intelligence/ubi-biologics-toolkit.git",
    "directory": "packages/ubi-biologics-typescript"
  },
  "homepage": "https://github.com/unibio-intelligence/ubi-biologics-toolkit",
  "bugs": {
    "url": "https://github.com/unibio-intelligence/ubi-biologics-toolkit/issues"
  }
}
