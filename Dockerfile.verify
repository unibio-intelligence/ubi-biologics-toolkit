FROM node:22-bookworm-slim AS node
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS verify
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
WORKDIR /toolkit
COPY . .
RUN uv sync --frozen --all-packages --group dev
RUN npm ci --ignore-scripts && npm --prefix packages/ubi-biologics-typescript ci --ignore-scripts
RUN uv run pytest -q
RUN npm --prefix packages/ubi-biologics-typescript test && npm --prefix packages/ubi-biologics-typescript run build
RUN uv build --package ubi-biologics-cli && uv build --package ubi-biologics-python
CMD ["uv", "run", "ubi-biologics-cli", "--help"]
